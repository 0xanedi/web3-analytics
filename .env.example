# Copy to .env (never commit .env). All tools work WITHOUT any of these keys.
# Optional only: holder/cohort dashboards fall back to free public RPC when unset.

# Etherscan V2 API key (free tier) - used for holder/cohort reconciliation only.
# https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Fallback EVM JSON-RPC endpoint (free, keyless). Override only if defaults rate-limit.
# Examples: https://eth.llamarpc.com, https://rpc.ankr.com/eth, https://ethereum-rpc.publicnode.com
EVM_RPC_URL=

# DefiLlama MCP: no key required. Free public REST APIs only.
# api.llama.fi / coins.llama.fi / yields.llama.fi / stablecoins.llama.fi
